#include <stdio.h>

// Function to print the array in reverse order
void printReverse(int arr[], int n) {
    // Loop backwards from the last index (n - 1) down to 0
    for (int i = n - 1; i >= 0; i--) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int n;

    // Read the number of elements
    if (scanf("%d", &n) != 1) {
        return 1;
    }

    // Allocate dynamic memory for the array
    int *arr = (int *)malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1; // Memory allocation failed
    }

    // Read the array elements
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 1;
        }
    }

    // Call the function to print in reverse
    printReverse(arr, n);

    // Free the allocated memory
    free(arr);

    return 0;
}
