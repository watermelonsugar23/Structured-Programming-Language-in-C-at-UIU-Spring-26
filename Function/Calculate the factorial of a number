#include <stdio.h>

int main() {
    int n; 
    int result = 1;

    // Ask the user to enter a number
    printf("Enter a number: ");
    scanf("%d", &n);

    // Loop to multiply numbers from 1 up to n
    for (int i = 1; i <= n; i++) {
        result = result * i;
    }

    // Print the final result
    printf("Output: %d\n", result);

    return 0;
}
