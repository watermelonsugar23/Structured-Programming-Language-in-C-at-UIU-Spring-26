#include <stdio.h>

// Function that multiplies elements by 2 and returns the array pointer
int* multiplyByTwo(int arr[], int size) {
    for (int i = 0; i < size; i++) {
        arr[i] = arr[i] * 2;
    }
    return arr; // Returns the pointer to the modified array
}

int main() {
    int n;

    // 1. Get the total number of elements
    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    // 2. Read the elements using scanf
    printf("Enter the elements:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // 3. Call the function and get the returned array pointer
    int* resultArr = multiplyByTwo(arr, n);

    // 4. Print the returned array
    printf("Sample output:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", resultArr[i]);
    }
    printf("\n");

    return 0;
}
