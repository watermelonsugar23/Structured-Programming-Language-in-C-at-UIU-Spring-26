#include <stdio.h>

int main() {
    int size;

    // 1. Ask the user for the number of elements
    printf("Enter number of elements in the array: ");
    scanf("%d", &size);

    int arr[size];

    // 2. Read the elements into the array using a loop
    printf("Enter %d numbers:\n", size);
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    // 3. Find the minimum value
    int min_val = arr[0]; // Start by assuming the first element is the smallest

    for (int i = 1; i < size; i++) {
        if (arr[i] < min_val) {
            min_val = arr[i]; // Update min_val if a smaller number is found
        }
    }

    // 4. Print the final result
    printf("Minimum Value: %d\n", min_val);

    return 0;
}
